DATABASE_URL=file:./dev.db # Prisma SQLite database URL
BETTER_AUTH_SECRET=example_32_byte_secret_change_me # better-auth secret
BETTER_AUTH_URL=http://localhost:3000 # API public URL
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173,atender://auth # CSV of trusted frontend/native origins
BETTER_AUTH_COOKIE_DOMAIN=localhost # Cookie domain for cross-subdomain cookies
RESEND_API_KEY=re_example # Resend API key for magic link mail
RESEND_FROM=Atender <noreply@example.com> # Magic link sender
GOOGLE_CLIENT_ID=example.apps.googleusercontent.com # Google OAuth client id
GOOGLE_CLIENT_SECRET=GOCSPX_example # Google OAuth client secret
APPLE_CLIENT_ID= # Optional Apple OAuth client id
APPLE_CLIENT_SECRET= # Optional Apple OAuth client secret
APPLE_APP_BUNDLE_ID= # Optional Apple app bundle id
PUBLIC_WEB_URL=http://localhost:5173 # Frontend public URL for CORS and links
PORT=3000 # API listen port
NODE_ENV=development # Runtime environment
